{{!
    @template block_coursecardsuems/summary

    Minimal reconstruction tracer bullet for the Course Cards UEMS block.

    Context variables required for this template:
    * title - short title shown inside the block
    * message - supporting message shown inside the block
    * hascourses - whether the current user has enrolled courses
    * courses - enrolled course summaries

    Example context (json):
    {
        "title": "Reconstruction in progress",
        "message": "The block architecture is being rebuilt.",
        "hascourses": true,
        "courses": [
            {"name": "Course name", "hasperiod": true, "period": "10/02/2026 – 20/05/2026"}
        ]
    }
}}
<div class="coursecardsuems-summary">
    <h3 class="coursecardsuems-summary-title">{{title}}</h3>
    <p class="coursecardsuems-summary-message">{{message}}</p>
    {{#hascourses}}
        <ul class="coursecardsuems-summary-courses">
            {{#courses}}
                <li class="coursecardsuems-summary-course">
                    <span class="coursecardsuems-summary-course-name">{{name}}</span>
                    {{#hasperiod}}
                        <span class="coursecardsuems-summary-course-period">{{period}}</span>
                    {{/hasperiod}}
                </li>
            {{/courses}}
        </ul>
    {{/hascourses}}
</div>
