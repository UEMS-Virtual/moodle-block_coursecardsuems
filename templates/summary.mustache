{{!
    @template block_coursecardsuems/summary

    Course sections for the UEMS EaD discipline block.

    Context variables required for this template:
    * hastitle    - whether title should be rendered
    * title       - optional title shown inside the block
    * hasmessage  - whether supporting message should be rendered
    * message     - optional supporting message
    * hassections - whether sections are available
    * sections    - status sections with course summaries

    Example context (json):
    {
        "hastitle": false,
        "title": "",
        "hasmessage": false,
        "message": "",
        "hassections": true,
        "sections": [
            {"title": "Abertas", "count": 1, "isopen": true, "isgrid": true, "hascourses": true, "courses": [{"title": "Course name", "code": "CODE", "hascode": true, "group": "CISOL-23", "series": "2ª Série", "hasseries": true, "period": {"hasperiod": true, "label": "10/02/2026 – 20/05/2026", "startlabel": "10/02/2026", "endlabel": "20/05/2026"}, "statuslabel": "Aberta", "statusclass": "coursecardsuems-status-open", "firstteachername": "Maria Docente", "firstteacherinitials": "MD"}]}
        ]
    }
}}
<div class="coursecardsuems-summary">
    {{#hastitle}}
        <h3 class="coursecardsuems-summary-title">{{title}}</h3>
    {{/hastitle}}
    {{#hasmessage}}
        <p class="coursecardsuems-summary-message">{{message}}</p>
    {{/hasmessage}}
    {{#hassections}}
        <div class="coursecardsuems-sections">
            {{#sections}}
                <details class="coursecardsuems-section coursecardsuems-section-{{key}}" {{#isopen}}open{{/isopen}}>
                    <summary class="coursecardsuems-section-summary">
                        <span class="coursecardsuems-section-title-text">{{title}}</span>
                        <span class="coursecardsuems-section-count">{{count}}</span>
                    </summary>
                    {{#hascourses}}
                        <div class="{{#isgrid}}coursecardsuems-grid{{/isgrid}}{{#islist}}coursecardsuems-list{{/islist}}">
                            {{#courses}}
                                {{> block_coursecardsuems/card}}
                            {{/courses}}
                        </div>
                    {{/hascourses}}
                    {{^hascourses}}
                        <p class="coursecardsuems-empty">{{emptytext}}</p>
                    {{/hascourses}}
                </details>
            {{/sections}}
        </div>
    {{/hassections}}
</div>
