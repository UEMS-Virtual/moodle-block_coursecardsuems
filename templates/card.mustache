{{!
    @template block_coursecardsuems/card

    Single discipline card — renders as <a> when clickable, <article> otherwise.
    Used as a partial inside block_coursecardsuems/summary.

    Context variables required for this template:
    * hasurl       - whether the card should link to the course
    * url          - course URL (only when hasurl)
    * linklabel    - accessible link label (only when hasurl)
    * isclosed     - whether the card is in the closed state
    * isreoferta   - whether the discipline is a re-offer
    * statusclass  - CSS modifier class for the status ribbon
    * statuslabel  - human-readable status label
    * hassupertitle - whether the supertitle (group · series) should render
    * supertitle   - combined group and series label
    * hascode      - whether a discipline code is available
    * code         - discipline shortname code
    * title        - discipline name
    * hasstripecolor - whether the configured stripe color should be applied
    * stripecolorstyle - CSS variable declaration for the configured stripe color
    * displayteachers     - up to two teachers shown in the avatar stack
    * teacherdisplayname  - teacher label; full name for one teacher, abbreviated names for two or more
    * hasseries    - whether a series label is available
    * series       - series label e.g. "2ª Série"
    * period       - object: hasperiod, showdates, label, startlabel, endlabel
    * ispreparing  - course is hidden while temporally open
}}
{{#hasurl}}
<a class="coursecardsuems-card {{#isclosed}}coursecardsuems-card-closed{{/isclosed}}"
   href="{{url}}"
   aria-label="{{linklabel}}"
   data-filter-level="{{filterlevel}}"
   data-filter-course="{{filtercourse}}"
   data-filter-group="{{filtergroup}}"
   data-filter-offer="{{filteroffer}}"
   {{#hasstripecolor}}style="{{stripecolorstyle}}"{{/hasstripecolor}}>
    {{> block_coursecardsuems/card_body}}
</a>
{{/hasurl}}
{{^hasurl}}
<article class="coursecardsuems-card coursecardsuems-card-disabled {{#isclosed}}coursecardsuems-card-closed{{/isclosed}}"
         aria-disabled="true"
         data-filter-level="{{filterlevel}}"
         data-filter-course="{{filtercourse}}"
         data-filter-group="{{filtergroup}}"
         data-filter-offer="{{filteroffer}}"
         {{#hasstripecolor}}style="{{stripecolorstyle}}"{{/hasstripecolor}}>
    {{> block_coursecardsuems/card_body}}
</article>
{{/hasurl}}
