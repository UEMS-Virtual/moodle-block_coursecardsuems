{{!
    @template block_coursecardsuems/summary

    Course sections rendered as tab panels for the UEMS EaD discipline block.
    JavaScript (block_coursecardsuems/section_tabs) handles tab switching.

    Context variables required for this template:
    * hassemesterlabel - whether semester header should be rendered
    * semesterlabel    - semester identifier, e.g. "2026/1"
    * hassections      - whether sections array is non-empty
    * sections         - array of status sections (key, title, count, isopen, isgrid, islist, hascourses, courses, emptytext)
    * hasperspectives  - whether the perspective switcher should be rendered
    * perspectives     - array of perspective options (key, label, count, isdefault)

    Example context (json):
    {
        "hassemesterlabel": true,
        "semesterlabel": "2026/1",
        "hassections": true,
        "sections": [
            {"key": "open", "title": "Abertas", "count": 1, "isopen": true, "isgrid": true, "hascourses": true, "emptytext": "Nenhum curso.", "courses": []}
        ]
    }
}}
<div class="coursecardsuems-summary"
     data-section-tabs
     data-active-key="open">

    {{#hassemesterlabel}}
        <div class="coursecardsuems-sem-header" aria-hidden="true">
            <span class="coursecardsuems-sem-prefix">{{#str}}semesterprefix, block_coursecardsuems{{/str}}</span>
            <span class="coursecardsuems-sem-value">{{semesterlabel}}</span>
        </div>
    {{/hassemesterlabel}}

    {{#hasperspectives}}
        <div class="coursecardsuems-perspectives" aria-label="{{#str}}perspectives, block_coursecardsuems{{/str}}">
            <span class="coursecardsuems-perspectives-label">{{#str}}viewas, block_coursecardsuems{{/str}}</span>
            <div class="coursecardsuems-perspective-options" role="list">
                {{#perspectives}}
                    <a class="coursecardsuems-perspective{{#isactive}} is-active{{/isactive}}"
                       role="listitem"
                       href="{{url}}"
                       data-perspective-key="{{key}}">
                        {{label}}
                        <span class="coursecardsuems-perspective-count" aria-hidden="true">{{count}}</span>
                    </a>
                {{/perspectives}}
            </div>
        </div>
    {{/hasperspectives}}

    {{#hassections}}
        <div class="coursecardsuems-tabs" role="tablist" aria-label="{{#str}}pluginname, block_coursecardsuems{{/str}}">
            {{#sections}}
                <button class="coursecardsuems-tab{{#isopen}} is-active{{/isopen}}"
                        role="tab"
                        data-key="{{key}}"
                        aria-selected="{{#isopen}}true{{/isopen}}{{^isopen}}false{{/isopen}}"
                        aria-controls="coursecardsuems-panel-{{key}}"
                        tabindex="{{#isopen}}0{{/isopen}}{{^isopen}}-1{{/isopen}}">
                    {{title}}
                    <span class="coursecardsuems-tab-count" aria-hidden="true">{{count}}</span>
                </button>
            {{/sections}}
        </div>

        {{#sections}}
            <div class="coursecardsuems-panel"
                 id="coursecardsuems-panel-{{key}}"
                 role="tabpanel"
                 data-key="{{key}}"
                 {{^isopen}}hidden{{/isopen}}>
                {{#hascourses}}
                    <div class="{{#isgrid}}coursecardsuems-grid{{/isgrid}}{{#islist}}coursecardsuems-list{{/islist}}">
                        {{#courses}}
                            {{> block_coursecardsuems/card}}
                        {{/courses}}
                    </div>
                {{/hascourses}}
                {{^hascourses}}
                    <p class="coursecardsuems-empty">{{emptytext}}</p>
                {{/hascourses}}
            </div>
        {{/sections}}
    {{/hassections}}
</div>
