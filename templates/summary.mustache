{{!
    @template block_coursecardsuems/summary

    Minimal reconstruction tracer bullet for the Course Cards UEMS block.

    Context variables required for this template:
    * title - short title shown inside the block
    * message - supporting message shown inside the block

    Example context (json):
    {
        "title": "Reconstruction in progress",
        "message": "The block architecture is being rebuilt."
    }
}}
<div class="coursecardsuems-summary">
    <h3 class="coursecardsuems-summary-title">{{title}}</h3>
    <p class="coursecardsuems-summary-message">{{message}}</p>
</div>
