{{!
    @template block_coursecardsuems/summary

    Course sections for the UEMS EaD discipline block.

    Context variables required for this template:
    * hastitle - whether title should be rendered
    * title - optional title shown inside the block
    * hasmessage - whether supporting message should be rendered
    * message - optional supporting message
    * hassections - whether sections are available
    * sections - status sections with course summaries

    Example context (json):
    {
        "hastitle": false,
        "title": "",
        "hasmessage": false,
        "message": "",
        "hassections": true,
        "sections": [
            {"title": "Abertas", "count": 1, "isopen": true, "isgrid": true, "hascourses": true, "courses": [{"title": "Course name", "code": "CODE", "hascode": true, "group": "CISOL-23", "series": "2ª Série", "hasseries": true, "period": {"hasperiod": true, "label": "10/02/2026 – 20/05/2026", "startlabel": "10/02/2026", "endlabel": "20/05/2026"}, "statuslabel": "Aberta", "statusclass": "coursecardsuems-status-open", "firstteachername": "Maria Docente", "firstteacherinitials": "MD"}]}
        ]
    }
}}
<div class="coursecardsuems-summary">
    {{#hastitle}}
        <h3 class="coursecardsuems-summary-title">{{title}}</h3>
    {{/hastitle}}
    {{#hasmessage}}
        <p class="coursecardsuems-summary-message">{{message}}</p>
    {{/hasmessage}}
    {{#hassections}}
        <div class="coursecardsuems-sections">
            {{#sections}}
                <details class="coursecardsuems-section coursecardsuems-section-{{key}}" {{#isopen}}open{{/isopen}}>
                    <summary class="coursecardsuems-section-summary">
                        <span class="coursecardsuems-section-title-text">{{title}}</span>
                        <span class="coursecardsuems-section-count">{{count}}</span>
                    </summary>

                    {{#hascourses}}
                        <div class="{{#isgrid}}coursecardsuems-grid{{/isgrid}}{{#islist}}coursecardsuems-list{{/islist}}">
                            {{#courses}}
                                {{#hasurl}}
                                    <a class="coursecardsuems-card {{#isclosed}}coursecardsuems-card-closed{{/isclosed}}" href="{{url}}" aria-label="{{linklabel}}">
                                        <div class="coursecardsuems-corner">
                                            {{#isreoferta}}
                                                <span class="coursecardsuems-ribbon-reoferta">{{#str}}reoferta, block_coursecardsuems{{/str}}</span>
                                            {{/isreoferta}}
                                            <span class="coursecardsuems-ribbon {{statusclass}}">{{statuslabel}}</span>
                                        </div>
                                        <div class="coursecardsuems-side">
                                            {{#hasgroup}}
                                                <span class="coursecardsuems-category-label">{{group}}</span>
                                            {{/hasgroup}}
                                            {{#hasseries}}
                                                <span class="coursecardsuems-series-side">{{series}}</span>
                                            {{/hasseries}}
                                            {{#period.hasperiod}}
                                                <span class="coursecardsuems-period">{{period.label}}</span>
                                            {{/period.hasperiod}}
                                        </div>
                                        <div class="coursecardsuems-main">
                                            <span class="coursecardsuems-status {{statusclass}}">{{statuslabel}}</span>
                                            <div class="coursecardsuems-title-group">
                                            {{#hassupertitle}}
                                                <div class="coursecardsuems-supertitle">{{supertitle}}{{#isreoferta}}<span class="coursecardsuems-reoferta-label"><span class="coursecardsuems-reoferta-dot" aria-hidden="true"></span>{{#str}}reoferta, block_coursecardsuems{{/str}}</span>{{/isreoferta}}</div>
                                            {{/hassupertitle}}
                                            <h4 class="coursecardsuems-title">
                                                {{#hascode}}
                                                    <span class="coursecardsuems-title-code">{{code}}</span>
                                                {{/hascode}}
                                                <span class="coursecardsuems-title-name">{{title}}</span>
                                            </h4>
                                            </div>
                                            <div class="coursecardsuems-footerline">
                                                <div class="coursecardsuems-teacher">
                                                    <span class="coursecardsuems-avatar" aria-hidden="true">{{firstteacherinitials}}</span>
                                                    <span class="coursecardsuems-teacher-text">
                                                        <span class="coursecardsuems-teacher-label">{{#str}}teacher, block_coursecardsuems{{/str}}</span>
                                                        <span class="coursecardsuems-teacher-name">{{firstteachername}}</span>
                                                        {{#hasteacherextra}}
                                                            <span class="coursecardsuems-teacher-extra">{{teacherextra}}</span>
                                                        {{/hasteacherextra}}
                                                    </span>
                                                </div>
                                                <div class="coursecardsuems-badges">
                                                    {{#hasseries}}
                                                        <span class="coursecardsuems-pill">{{series}}</span>
                                                    {{/hasseries}}
                                                </div>
                                                {{#period.showdates}}
                                                    <div class="coursecardsuems-dates">
                                                        <i class="fa-regular fa-calendar coursecardsuems-date-icon" aria-hidden="true"></i>
                                                        <span class="coursecardsuems-date-value">{{period.startlabel}}</span>
                                                        <span class="coursecardsuems-date-separator">–</span>
                                                        <span class="coursecardsuems-date-value">{{period.endlabel}}</span>
                                                    </div>
                                                {{/period.showdates}}
                                                {{^period.showdates}}{{#ispreparing}}
                                                    <div class="coursecardsuems-dates">
                                                        <span class="coursecardsuems-date-value">{{period.label}}</span>
                                                    </div>
                                                {{/ispreparing}}{{/period.showdates}}
                                            </div>
                                        </div>
                                    </a>
                                {{/hasurl}}
                                {{^hasurl}}
                                    <article class="coursecardsuems-card coursecardsuems-card-disabled {{#isclosed}}coursecardsuems-card-closed{{/isclosed}}" aria-disabled="true">
                                        <div class="coursecardsuems-corner">
                                            {{#isreoferta}}
                                                <span class="coursecardsuems-ribbon-reoferta">{{#str}}reoferta, block_coursecardsuems{{/str}}</span>
                                            {{/isreoferta}}
                                            <span class="coursecardsuems-ribbon {{statusclass}}">{{statuslabel}}</span>
                                        </div>
                                        <div class="coursecardsuems-side">
                                            {{#hasgroup}}
                                                <span class="coursecardsuems-category-label">{{group}}</span>
                                            {{/hasgroup}}
                                            {{#hasseries}}
                                                <span class="coursecardsuems-series-side">{{series}}</span>
                                            {{/hasseries}}
                                            {{#period.hasperiod}}
                                                <span class="coursecardsuems-period">{{period.label}}</span>
                                            {{/period.hasperiod}}
                                        </div>
                                        <div class="coursecardsuems-main">
                                            <span class="coursecardsuems-status {{statusclass}}">{{statuslabel}}</span>
                                            <div class="coursecardsuems-title-group">
                                            {{#hassupertitle}}
                                                <div class="coursecardsuems-supertitle">{{supertitle}}{{#isreoferta}}<span class="coursecardsuems-reoferta-label"><span class="coursecardsuems-reoferta-dot" aria-hidden="true"></span>{{#str}}reoferta, block_coursecardsuems{{/str}}</span>{{/isreoferta}}</div>
                                            {{/hassupertitle}}
                                            <h4 class="coursecardsuems-title">
                                                {{#hascode}}
                                                    <span class="coursecardsuems-title-code">{{code}}</span>
                                                {{/hascode}}
                                                <span class="coursecardsuems-title-name">{{title}}</span>
                                            </h4>
                                            </div>
                                            <div class="coursecardsuems-footerline">
                                                <div class="coursecardsuems-teacher">
                                                    <span class="coursecardsuems-avatar" aria-hidden="true">{{firstteacherinitials}}</span>
                                                    <span class="coursecardsuems-teacher-text">
                                                        <span class="coursecardsuems-teacher-label">{{#str}}teacher, block_coursecardsuems{{/str}}</span>
                                                        <span class="coursecardsuems-teacher-name">{{firstteachername}}</span>
                                                        {{#hasteacherextra}}
                                                            <span class="coursecardsuems-teacher-extra">{{teacherextra}}</span>
                                                        {{/hasteacherextra}}
                                                    </span>
                                                </div>
                                                <div class="coursecardsuems-badges">
                                                    {{#hasseries}}
                                                        <span class="coursecardsuems-pill">{{series}}</span>
                                                    {{/hasseries}}
                                                </div>
                                                {{#period.showdates}}
                                                    <div class="coursecardsuems-dates">
                                                        <i class="fa-regular fa-calendar coursecardsuems-date-icon" aria-hidden="true"></i>
                                                        <span class="coursecardsuems-date-value">{{period.startlabel}}</span>
                                                        <span class="coursecardsuems-date-separator">–</span>
                                                        <span class="coursecardsuems-date-value">{{period.endlabel}}</span>
                                                    </div>
                                                {{/period.showdates}}
                                                {{^period.showdates}}{{#ispreparing}}
                                                    <div class="coursecardsuems-dates">
                                                        <span class="coursecardsuems-date-value">{{period.label}}</span>
                                                    </div>
                                                {{/ispreparing}}{{/period.showdates}}
                                            </div>
                                        </div>
                                    </article>
                                {{/hasurl}}
                            {{/courses}}
                        </div>
                    {{/hascourses}}
                    {{^hascourses}}
                        <p class="coursecardsuems-empty">{{emptytext}}</p>
                    {{/hascourses}}
                </details>
            {{/sections}}
        </div>
    {{/hassections}}
</div>
